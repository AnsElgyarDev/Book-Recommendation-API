# Copy this file to .env and adjust as needed.
# In dev, leave this as /api so requests go through the Vite proxy in vite.config.js
# (which forwards to your .NET API and avoids CORS/self-signed-cert headaches).
# In production, point this at your deployed API's origin, e.g. https://api.bookhub.app/api
VITE_API_BASE_URL=/api
